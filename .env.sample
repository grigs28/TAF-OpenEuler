# ============================================================================
# 企业级磁带备份系统 - 配置文件模板 (Linux openEuler)
# Enterprise Tape Backup System - Configuration Template
# ============================================================================
#
# 使用说明:
# 1. 复制此文件为 .env: cp .env.sample .env
# 2. 根据实际情况修改配置
# 3. 敏感信息（密码、密钥等）请妥善保管，不要提交到版本控制系统
#
# ============================================================================

# ----------------------------------------------------------------------------
# 应用基础配置
# ----------------------------------------------------------------------------
# 应用名称
APP_NAME=企业级磁带备份系统

# 调试模式：true=开发模式（会显示详细错误信息）；false=生产模式
# 开发模式下可能会显示敏感调试信息，生产环境请将 DEBUG 设置为 false
DEBUG=false

# 运行环境：development（开发）/ production（生产）/ testing（测试）
ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Web 服务器配置
# ----------------------------------------------------------------------------
# Web 服务器监听地址（0.0.0.0 表示监听所有网络接口）
WEB_HOST=0.0.0.0

# Web 服务器端口
WEB_PORT=8081

# Web 应用工作者进程数（建议配置为 CPU 核心数）
WEB_WORKERS=4

# Web 静态文件目录（CSS、JS、图片等）
WEB_STATIC_DIR=web/static

# Web 模板文件目录（HTML 模板）
WEB_TEMPLATE_DIR=web/templates

# 最大上传文件大小（字节数），默认 1GB = 1073741824
MAX_UPLOAD_SIZE=1073741824

# 允许跨域请求（允许不同源的脚本访问）
# true=允许跨域访问；false=禁止跨域访问
ENABLE_CORS=true

# CORS 允许的来源（* 表示允许所有来源）
# 生产环境建议配置为具体的源地址，例如：http://192.168.0.28:8081
CORS_ORIGINS=*

# 允许使用 GZIP 压缩（压缩响应内容，提高传输效率）
ENABLE_GZIP=true

# ----------------------------------------------------------------------------
# 数据库配置 (openGauss)
# ----------------------------------------------------------------------------
# 数据库连接 URL（推荐使用 openGauss 方式）
# 格式：opengauss://用户名:密码@主机:端口/数据库名
# 示例：opengauss://username:password@192.168.0.20:5560/backup_db
DATABASE_URL=opengauss://username:password@localhost:5432/backup_db

# 数据库连接参数（如果配置了 DATABASE_URL，则部分参数会被省略）
# 数据库主机地址
DB_HOST=localhost

# 数据库端口（openGauss 默认端口：5432）
DB_PORT=5432

# 数据库用户名
DB_USER=username

# 数据库密码（请修改为实际密码）
DB_PASSWORD=password

# 数据库名称
DB_DATABASE=backup_db

# 数据库连接池大小（同时维持的数据库连接数）
DB_POOL_SIZE=10

# 数据库连接池最大溢出数（超出连接池大小后，临时创建的最大连接数）
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------------
# 安全配置
# ----------------------------------------------------------------------------
# JWT 密钥（用于用户身份验证和权限访问）
# 生产环境请使用已更换的密钥，生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT 算法（通常使用 HS256）
ALGORITHM=HS256

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# 磁带设备配置 (Linux)
# ----------------------------------------------------------------------------
# Linux 磁带设备路径
# 示例：/dev/nst0 表示第一个非倒带磁带设备
TAPE_DEVICE_PATH=/dev/nst0

# LTFS SCSI 设备路径
# 示例：/dev/sg2 表示第二个 SCSI 通用设备
LTFS_DEVICE_PATH=/dev/sg2

# 默认数据块大小（字节数），256KB = 262144
# 磁带读写块大小，通常不需要更改
DEFAULT_BLOCK_SIZE=262144

# 最大卷大小（字节数），300GB = 322122547200
# 单个磁带的最大容量限制
MAX_VOLUME_SIZE=322122547200

# Linux SCSI 设备路径（可选，多个设备用逗号分隔）
# 示例：/dev/nst0 表示第一个非倒带磁带设备
TAPE_DEVICES_PATH=/dev/nst0

# 是否在完整备份前自动格式化磁带
ENABLE_TAPE_FORMAT_BEFORE_FULL=false

# ----------------------------------------------------------------------------
# LTFS 配置
# ----------------------------------------------------------------------------
# LTFS 二进制文件路径
LTFS_BINARY_PATH=/usr/local/bin/ltfs

# LTFS 挂载点
LTFS_MOUNT_POINT=/mnt/ltfs

# LTFS 同步模式（true=同步写入，false=异步写入）
LTFS_SYNC_MODE=false

# LTFS 工具目录
LTFS_TOOLS_DIR=/usr/local/bin

# ----------------------------------------------------------------------------
# 磁带管理配置
# ----------------------------------------------------------------------------
# 磁带池大小（网络中维护的磁带总数）
TAPE_POOL_SIZE=12

# 磁带检查间隔（毫秒），默认 3600000 = 1小时
# 系统会定期检查磁带驱动器状态
TAPE_CHECK_INTERVAL=3600

# 自动清理过期磁带
# true=自动清理；false=手动清理
AUTO_TAPE_CLEANUP=true

# ----------------------------------------------------------------------------
# 压缩配置
# ----------------------------------------------------------------------------
# 压缩方法：zstd（Zstandard，推荐）
# 可选：zstd, pgzip, tar
COMPRESSION_METHOD=zstd

# 压缩级别（zstd: 1-19，推荐 3）
# 数字越大压缩率越高，但速度越慢
COMPRESSION_LEVEL=3

# 压缩块大小（字节数），64MB = 67108864
# 与内存使用相关，压缩块大小与压缩速度成正比
SOLID_BLOCK_SIZE=67108864

# 单个压缩文件最大大小（字节数），12GB = 12884901888
# 超过此大小的文件会被分割成多个压缩包
MAX_FILE_SIZE=12884901888

# 压缩线程数
# 建议配置为 CPU 核心数，多线程可提高压缩速度
COMPRESSION_THREADS=4

# ----------------------------------------------------------------------------
# 扫描配置
# ----------------------------------------------------------------------------
# 扫描批次大小（文件数）
# 默认 3000 个文件，可根据实际磁盘 I/O 性能调整配置
SCAN_BATCH_SIZE=3000

# 扫描批次大小（字节数）
# 默认 3GB = 3221225472，与 MAX_FILE_SIZE 保持一致
# 当扫描剩余文件超过此大小时开始压缩
SCAN_BATCH_SIZE_BYTES=3221225472

# ----------------------------------------------------------------------------
# 目录配置
# ----------------------------------------------------------------------------
# 备份临时目录（在备份过程中存储临时文件）
BACKUP_TEMP_DIR=temp/backup

# 恢复临时目录（在恢复过程中存储临时文件）
RECOVERY_TEMP_DIR=temp/recovery

# 默认保留期（月）
# 磁带数据默认保留多长时间后可以被擦除
DEFAULT_RETENTION_MONTHS=6

# 自动擦除过期磁带
# true=自动擦除；false=手动擦除
AUTO_ERASE_EXPIRED=true

# ----------------------------------------------------------------------------
# 计划任务配置
# ----------------------------------------------------------------------------
# 启用计划任务调度器
SCHEDULER_ENABLED=true

# 每月备份 Cron 表达式（已在 Web 界面配置调度，此为默认值）
# 格式：分 时 日 月 周
# 示例：0 2 1 * * 表示每月1号 02:00 执行
MONTHLY_BACKUP_CRON=0 2 1 * *

# 保留期检查 Cron 表达式（已在 Web 界面配置调度，此为默认值）
# 格式：分 时 日 月 周
# 示例：0 3 * * * 表示每天 03:00 执行
RETENTION_CHECK_CRON=0 3 * * *

# ----------------------------------------------------------------------------
# 钉钉通知配置
# ----------------------------------------------------------------------------
# 钉钉通知 API 地址
# 根据实际部署的钉钉中间件服务地址修改
DINGTALK_API_URL=http://localhost:5555

# 钉钉 API 密钥（请修改为实际的 API 密钥）
DINGTALK_API_KEY=your-dingtalk-api-key

# 钉钉默认通知手机号
DINGTALK_DEFAULT_PHONE=13800000000

# ----------------------------------------------------------------------------
# 微信通知配置（可选）
# ----------------------------------------------------------------------------
# 企业微信机器人 Webhook URL
WECHAT_WEBHOOK_URL=

# 是否启用微信通知
WECHAT_ENABLED=false

# 备份进度汇报间隔（分钟）
WECHAT_REPORT_INTERVAL=30

# ----------------------------------------------------------------------------
# SMB/CIFS 网络路径配置（可选）
# ----------------------------------------------------------------------------
# SMB 用户名
SMB_USERNAME=

# SMB 密码
SMB_PASSWORD=

# SMB 域
SMB_DOMAIN=

# SMB 挂载基础目录
SMB_MOUNT_BASE=/mnt/smb

# ----------------------------------------------------------------------------
# 日志配置
# ----------------------------------------------------------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
# DEBUG=详细调试信息；INFO=一般信息；WARNING=警告；ERROR=错误；CRITICAL=严重错误
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/application.log

# 日志备份数量（保留最近 N 个日志文件）
LOG_BACKUP_COUNT=30

# ----------------------------------------------------------------------------
# 监控配置
# ----------------------------------------------------------------------------
# 启用性能指标收集
METRICS_ENABLED=true

# 健康检查间隔（毫秒），默认 300000 = 5分钟
HEALTH_CHECK_INTERVAL=300

# ----------------------------------------------------------------------------
# 高级配置
# ----------------------------------------------------------------------------
# 异步连接池大小（异步执行的最大并发连接数）
ASYNC_POOL_SIZE=20

# 异步连接池最大溢出数
ASYNC_MAX_OVERFLOW=40

# 启用查询缓存（缓存数据库查询结果，提高性能）
ENABLE_QUERY_CACHE=true

# 查询缓存 TTL（缓存有效期，单位：秒）
QUERY_CACHE_TTL=300

# WebSocket 心跳间隔（秒）
WEBSOCKET_HEARTBEAT=30

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# ----------------------------------------------------------------------------
# 数据目录配置
# ----------------------------------------------------------------------------
# 数据目录（存储数据库文件等）
DATA_DIR=data

# ----------------------------------------------------------------------------
# 通知事件配置（JSON 格式）
# ----------------------------------------------------------------------------
# 配置需要发送通知的事件
# 格式：{"事件名": true/false}
# true=只发送通知；false=不发送通知
NOTIFICATION_EVENTS={"notify_backup_success": true, "notify_backup_started": true, "notify_backup_failed": true, "notify_recovery_success": true, "notify_recovery_failed": true, "notify_tape_change": true, "notify_tape_expired": true, "notify_tape_error": true, "notify_capacity_warning": true, "notify_system_error": true, "notify_system_started": false}

# ----------------------------------------------------------------------------
# 磁带设备缓存（自动生成，一般不需要手动配置）
# ----------------------------------------------------------------------------
# 系统会自动检测并缓存磁带设备信息
# 格式：JSON 数组，包含设备路径、类型、供应商、型号等
# 示例：
# TAPE_DEVICES_CACHE=[{"path": "/dev/nst0", "type": "SCSI tape", "rewinding": false, "vendor": "IBM", "model": "ULT3580-HH9", "status": "online"}]
TAPE_DEVICES_CACHE=

# ============================================================================
# 配置文件模板结束
# ============================================================================
